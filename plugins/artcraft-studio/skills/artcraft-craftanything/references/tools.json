      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "faces": {
          "default": null,
          "description": "Most faces the model may have, 48 to 20000 (default 3000). Fewer faces run faster.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "image": {
          "default": "",
          "description": "A picture to turn into the model: a web address, or a picture inside the project.",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "description": "What to make: one object, described in detail. Used when no image is given.",
          "type": "string"
        },
        "save_as": {
          "description": "Where to save it, relative to app/, ending in .glb (e.g. Assets/Models/crate.glb).",
          "type": "string"
        },
        "textured": {
          "default": null,
          "description": "Colours and surfaces (default true); false makes a plain grey model for $0.40 instead of $0.50.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "save_as"
      ],
      "title": "ModelParams",
      "type": "object"
    },
    "name": "assets_model_generate",
    "title": "Generate a 3D model"
