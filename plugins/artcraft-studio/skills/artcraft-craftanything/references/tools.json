      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Record a finding"
    },
    "description": "Record a settled answer. Requires at least one evidence id; every id is checked against the ledger. Findings are the source for reports.",
    "inputSchema": {
      "$defs": {
        "ConfidenceParam": {
          "enum": [
            "observed",
            "derived",
            "inferred"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceParam",
          "description": "observed (read directly), derived (computed from observations) or inferred (best guess)."
        },
        "evidence_ids": {
          "description": "Evidence ids that establish it (at least one).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "statement": {
          "description": "The settled answer, in one or two sentences.",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "evidence_ids"
      ],
      "title": "FindingParams",
      "type": "object"
    },
