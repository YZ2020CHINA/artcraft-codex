      ],
      "title": "SaveParams",
      "type": "object"
    },
    "name": "core_report_save",
    "title": "Save a report"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Write a readable report"
    },
    "description": "Turn the investigation (brief, plan, findings, hypotheses, handoff) and the evidence ledger into a readable report: what we looked at, what we found (each finding with its plain-English summary, confidence and cited evidence), open questions, and how it was done. format=markdown (default) or html. With an absolute path it writes the file (WRITES_FILESYSTEM); otherwise it returns the text.",
    "inputSchema": {
      "$defs": {
        "ReportFormat": {
          "enum": [
            "markdown",
            "html"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/ReportFormat",
          "default": "markdown",
          "description": "markdown (default) or html. HTML is a self-contained styled page."
        },
        "include_evidence": {
          "default": true,
          "description": "Include the full evidence ledger as an appendix (default true). Findings always cite ids.",
          "type": "boolean"
        },
        "path": {
          "default": null,
          "description": "Absolute path to write the report to. When omitted the text is returned instead.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "ReportParams",
      "type": "object"
    },
    "name": "core_report_write",
    "title": "Write a readable report"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Page through evidence"
    },
    "description": "View part of a stored (or inline) evidence record: the summary, one part, one row of a list, a page of a list's rows (optionally only the rows matching given field values, cut to chosen fields, with the field names listed), or a part of a function dossier (pseudocode, assembly, basic_blocks, callers, callees, flow_*…), with coverage and next_offset. Nothing is analysed again.",
    "inputSchema": {
      "$defs": {
        "RecordSource": {
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "Evidence already recorded in this session or project.",
              "properties": {
                "evidence_id": {
                  "type": "string"
                },
                "kind": {
                  "const": "saved",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "evidence_id"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A full evidence record passed inline.",
              "properties": {
                "evidence": true,
                "kind": {
                  "const": "inline",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "evidence"
              ],
              "type": "object"
            }
          ]
        },
        "Show": {
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "The record without its result.",
              "properties": {
                "kind": {
                  "const": "summary",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "One named part of the result (e.g. mitigations, linkage).",
              "properties": {
                "kind": {
                  "const": "part",
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "One row of a list: by index, or the first whose name/address equals `pick`.",
              "properties": {
                "kind": {
                  "const": "row",
                  "type": "string"
                },
                "list": {
                  "type": "string"
                },
                "pick": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "list",
                "pick"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A page of a list (sections, symbols, functions…).",
              "properties": {
                "field_names": {
                  "default": false,
                  "description": "Also list the field names of the matching rows, to see what to match or pick.",
                  "type": "boolean"
                },
                "fields": {
                  "default": [],
                  "description": "Return only these fields of each row (`a.b` reaches inside); a row without one leaves it out.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "kind": {
                  "const": "rows",
                  "type": "string"
                },
                "limit": {
                  "default": 64,
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "list": {
                  "type": "string"
                },
                "matching": {
                  "additionalProperties": true,
                  "default": {},
                  "description": "Keep only the rows whose fields equal these values, e.g. `{\"kind\": \"require\", \"path\":\n[\"main.js\", \"preload.js\"]}`: every field must match, a list means any of its values,\n`a.b` reaches inside a row and null matches a field the row doesn't have.",
                  "type": "object"
                },
                "offset": {
                  "default": 0,
                  "description": "Counts matching rows when `matching` is given.",
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "list"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A part of a native function dossier (pseudocode, assembly, basic_blocks, callers, callees,\nincoming_references, outgoing_references, unresolved_calls, referenced_strings,\nreferenced_names, native_api, flow_summary, flow_nodes,\nflow_edges, flow_effects, flow_parameters, flow_parameter_uses,\ncomments, function). Text facets page by UTF-16 units.",
              "properties": {
                "kind": {
                  "const": "function-part",
                  "type": "string"
                },
                "limit": {
                  "default": 64,
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "offset": {
                  "default": 0,
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "show": {
          "$ref": "#/$defs/Show",
          "description": "What part of it to show."
        },
        "source": {
          "$ref": "#/$defs/RecordSource",
          "description": "Where the evidence comes from."
        }
      },
      "required": [
        "source",
        "show"
      ],
      "title": "ShowParams",
      "type": "object"
    },
    "name": "core_evidence_browse",
    "title": "Page through evidence"
  },
