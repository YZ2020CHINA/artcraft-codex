  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Read the journal"
    },
    "description": "Page through the project's append-only journal (tool calls, model turns, consents, errors), filtered by day, kind or tool. Needs an open project.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "day": {
          "default": null,
          "description": "Day to read (`YYYY-MM-DD`); the latest day when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "default": null,
          "description": "Only entries of this kind (`tool_call`, `model_turn`, `consent`, `user_message`, `error`…).",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": null,
          "description": "At most 500; default 50.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "tool": {
          "default": null,
          "description": "Only calls of this tool.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "JournalParams",
      "type": "object"
