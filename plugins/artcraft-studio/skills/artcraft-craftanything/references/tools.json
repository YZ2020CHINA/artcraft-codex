            "database",
            "projects",
            "setup",
            "build",
            "all"
          ],
          "type": "string"
        }
      },
      "required": [
        "toolset"
      ],
      "type": "object"
    },
    "name": "enable_toolset",
    "title": "Enable a toolset"
  }
