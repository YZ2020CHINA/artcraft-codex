        "wait_minutes": {
          "default": 20,
          "description": "Longest wait for the result, in minutes (1..=60, default 20): a website with several pages\nor a game's engine build takes a few minutes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "CheckParams",
      "type": "object"
    },
    "name": "rebuild_check",
    "title": "Check my build"
