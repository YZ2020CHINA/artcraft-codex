    "description": "Save a report a client composed (Markdown, HTML or plain text) to an absolute path the person chose. Only .md, .html, .htm or .txt files.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Where to save it: an absolute path ending in .md, .html, .htm or .txt.",
          "type": "string"
        },
        "text": {
          "description": "The report's text.",
          "type": "string"
        }
      },
      "required": [
        "path",
